# KINETIC configuration. Copy to .env. Each process (verifier, provider, buyer agent) is one
# role with its own key, so run each from its own shell or env file.
#
# `npm run setup:testnet` writes a complete env file per role to .kinetic/testnet/ from
# just the four inputs below; you only need the rest to run roles by hand.

# ── setup:testnet inputs ──────────────────────────────────────────────────────
# One funded Hedera testnet account (portal.hedera.com). Its key may be 0x-hex ECDSA or DER.
OPERATOR_ID=0.0.xxxxxx
OPERATOR_KEY=0x...
# A wallet funded at https://hub.arkiv.network/faucet (defaults to OPERATOR_KEY if that is 0x-hex).
ARKIV_FUNDER_KEY=0x...
ARKIV_FUND_PER_ROLE=0.01

# KINETIC runs on testnet (the default). devnet is only the automated tests' emulator.
KINETIC_NETWORK=testnet

# ── Identity (per role) ───────────────────────────────────────────────────────
# One secp256k1 key per role (`npm run keys`). The same key is the role's Hedera ECDSA
# account, its Arkiv owner wallet, and its vault address.
KINETIC_PRIVATE_KEY=0x...
HEDERA_ACCOUNT_ID=0.0.xxxxxx

# ── Hedera ────────────────────────────────────────────────────────────────────
# x402 facilitator that settles hedera:testnet payments. Quotes fail over to the next healthy one:
# this one first, then x402.org, Blocky402 and Launa. X402_FACILITATOR_URLS (comma-separated)
# replaces the whole list. A payment is settled by the facilitator that quoted it.
X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_FACILITATOR_URLS=https://x402.org/facilitator,https://api.testnet.blocky402.com,https://testnet.facilitator.launa.dev
# Payments are HBAR, the same asset as bonds, so a slash refunds exactly what was paid.
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
# From `npm run create:topic` (run with the verifier's key).
HCS_TOPIC_ID=
# From `npm run deploy:vault` (or npm run setup:testnet, which sets all of this up).
BOND_VAULT_ADDRESS=
# Vault rules, read by npm run deploy:vault. A slash needs VAULT_THRESHOLD signatures from
# VAULT_VERIFIERS; a disputed one needs VAULT_DISPUTE_THRESHOLD to decide it either way.
# VAULT_VERIFIERS=0xverifier,0xverifier2,0xverifier3
# VAULT_THRESHOLD=2
# VAULT_DISPUTE_THRESHOLD=3
# Seconds a slash stays open to dispute (short for testnet demos; use hours in production),
# and seconds the verifiers get to decide a dispute before it is cancelled.
# VAULT_DISPUTE_WINDOW=60
# VAULT_RESOLVE_TIMEOUT=600
# VAULT_MIN_CHALLENGE_TINYBAR=10000000
# VAULT_WITHDRAW_DELAY=86400
# What a slash proposal pays the vault to execute the slash itself when the window closes (HIP-1215
# scheduled call). Default: the call's gas limit at the current gas price + 10%. 0 disables it.
# VAULT_SCHEDULE_FEE_TINYBAR=

# ── Arkiv ─────────────────────────────────────────────────────────────────────
# Rabdi, Arkiv's current testnet (chain id and explorer follow from the URL). @arkiv-network/sdk 1.0
# speaks only Rabdi's protocol, not the earlier Tiramisu testnet's.
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
# Access key from https://hub.arkiv.network/access-keys. Without one the public RPC rate-limits
# anonymous callers (ANON_RATE_LIMITED), which five providers plus a dashboard can hit.
ARKIV_API_KEY=
# Namespace attribute on every entity; change it to keep test runs apart.
ARKIV_APP=kinetic

# ── Swarm ─────────────────────────────────────────────────────────────────────
# Defaults to the public gateway (https://api.gateway.ethswarm.org), which accepts small
# uploads without a postage batch but keeps them only for a while. For storage that lasts,
# point BEE_URL at your own Bee node and buy a batch with `npm run swarm:stamp`.
# Downloads of 64-hex references are checked chunk by chunk against their address either way.
BEE_URL=
BEE_POSTAGE_BATCH_ID=
SWARM_GATEWAY_URL=
SWARM_ENCRYPT=true

# ── 0G Private Computer ───────────────────────────────────────────────────────
# The verifier's reference runs use ZEROG_MODEL; providers on
# PROVIDER_BACKEND=0g run their work here too, with their own key.
ZEROG_BASE_URL=https://router-api.0g.ai/v1
ZEROG_API_KEY=
# A model with `verifiability` set in GET /v1/models. glm-5.3 is TeeML (served by 0G Compute
# nodes) and differs from the providers' default 0gm-1.0-35b-a3b, so canaries compare two models.
ZEROG_MODEL=glm-5.3
ZEROG_TRUST_MODE=verified
# Canary reference runs: `private` routes to TeeML providers only (the model runs in the 0G
# provider's enclave). With none free the run repeats in ZEROG_CANARY_FALLBACK mode and the
# canary records it; `none` leaves the canary unscored instead. glm-5.3's TeeML providers don't
# take `seed`, so canaries run at temperature 0 with no seed.
ZEROG_CANARY_TRUST_MODE=private
ZEROG_CANARY_FALLBACK=verified
# Where the router's providers' TEE signers are looked up: 0G mainnet (chain 16661), not Galileo.
ZEROG_TEE_RPC_URL=https://evmrpc.0g.ai

# ── Verification policy (verifier only) ───────────────────────────────────────
# Share of chunks secretly re-run on 0G as canaries.
CANARY_RATE=0.25
CANARY_MIN=1
# Slash when CANARY_FAIL_LIMIT of the last CANARY_WINDOW canaries fail.
CANARY_WINDOW=10
CANARY_FAIL_LIMIT=3
# A canary passes when per-item agreement with 0G is at least this.
CANARY_MIN_AGREEMENT=0.8
# Plant one of the verifier's labelled examples in every chunk as a known answer (default true).
# Missed known answers are what slashing rests on. The labelled set is GOLD_TASK / GOLD_SET
# (default data/classify-tickets.task.json, data/gold-tickets.jsonl); cosigners need the same one.
# KNOWN_ANSWERS=true
# Let disagreeing with the 0G reference model count toward slashing (default false: two models can
# both be reasonable, so it only fails the chunk and quarantines the provider for the job).
# CANARY_MODEL_SLASHES=false
# Chunks re-run on 0G after each job, picked by a Hedera PRNG seed the verifier draws in the vault
# after the canary reveal (default 1; 0 turns it off).
# SPOT_CHECKS=1
# The verifier's x402 fee per chunk, paid when a job registers (10,000 tinybar = 0.0001 HBAR).
VERIFIER_FEE_PER_CHUNK_TINYBAR=10000
VERIFIER_PORT=4500
# The vault's other verifiers (npm run cosigner on each), asked to re-check and co-sign every slash.
# VERIFIER_COSIGNERS=http://localhost:4510,http://localhost:4520
# How long finalizing a job waits for its slashes' dispute windows to close (seconds).
# SLASH_SETTLE_WAIT=120
# A cosigner's own port (npm run cosigner). It needs ZEROG_API_KEY: it re-runs failed canaries.
# COSIGNER_PORT=4510
# Where the verifier keeps open jobs and every gate keeps used payment headers, so a restart
# loses neither. Default .kinetic/testnet/state on testnet; off on devnet. Holds job keys.
# KINETIC_STATE_DIR=

# ── Model hub (verifier) ──────────────────────────────────────────────────────
# A model is listed only with a benchmark at or above MODEL_MIN_ACCURACY, scored on
# MODEL_BENCHMARK_ITEMS labelled examples the creator never saw. The creator pays the listing fee
# over x402. Verifiers run self-hosted (engine "openai") models on VERIFIER_MODEL_URL.
# MODEL_MIN_ACCURACY=0.7
# MODEL_BENCHMARK_ITEMS=12
# MODEL_LISTING_FEE_TINYBAR=1000000
# MODEL_MAX_DOWNLOAD_MB=512          raise it (e.g. 4096) for self-hosted models with multi-GB weights
# VERIFIER_MODEL_URL=http://localhost:11434/v1
# Model weights on 0G Storage (Galileo testnet). Uploads pay 0G's storage fee from the role's key.
# ZG_STORAGE_RPC_URL=https://evmrpc-testnet.0g.ai
# ZG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# ── Provider node ─────────────────────────────────────────────────────────────
PROVIDER_NAME=my-provider
PROVIDER_PORT=5101
# Public URL buyers will call.
PROVIDER_PUBLIC_URL=http://localhost:5101
# What your compute really is, shown to buyers.
PROVIDER_GPU=0G Compute (TeeML)
PROVIDER_TASKS=classify,extract,tag
# 1 HBAR = 100,000,000 tinybar.
PROVIDER_PRICE_TINYBAR=100000
PROVIDER_BOND_TINYBAR=100000000
# Set by `npm run register:hol` once the provider is listed in the Hashgraph Online registry (HCS-10).
# HOL_INBOUND_TOPIC_ID=
# 0g: run through the 0G router with ZEROG_API_KEY (default model 0gm-1.0-35b-a3b, 0G's own TeeML
#   model). The router picks the 0G node; results don't say which.
# 0g-compute: run on one 0G Compute provider, called directly, chosen by its on-chain address
#   (ZG_PROVIDER_ADDRESS). Every result names it, its model and the chat id its TEE signed; the
#   verifier checks that signature and that it covers the exact response the result came from,
#   and records the attestation as verified, unavailable or invalid (never unavailable as verified).
#   A chunk whose 0G provider fails is rerouted to a different 0G provider. `npm run zerog` lists
#   them, proposes an assignment, prices a live job (plan) and funds the ledger (fund --yes).
# openai: your own OpenAI-compatible server (Ollama, vLLM, llama.cpp) at PROVIDER_MODEL_URL.
# A provider runs exactly what it declares; there is no fallback.
PROVIDER_BACKEND=0g
PROVIDER_MODEL=0gm-1.0-35b-a3b
# For PROVIDER_BACKEND=0g-compute: the 0G provider, and the 0G wallet whose compute ledger pays
# (at least 3 0G in the ledger plus 1 0G per 0G provider; the role's own key when unset).
# ZG_PROVIDER_ADDRESS=0x1cb95eb66cc67c62d4de0cc96726c5a5d82e7c85
# ZG_PRIVATE_KEY=
# ZG_RPC_URL=https://evmrpc-testnet.0g.ai
# For PROVIDER_BACKEND=openai:
# PROVIDER_MODEL_URL=http://localhost:11434/v1
# PROVIDER_MODEL_API_KEY=
# honest. Anything else makes an adversarial test provider that really cheats and says so in
# its offer: lazy | flaky | offline-after:N | degrade-after:N | zg-down-after:N (simulates its 0G
# Compute provider going down after N chunks, to exercise rerouting to an independent 0G provider)
PROVIDER_BEHAVIOR=honest
# Listed models to serve, comma-separated ("namespace/name", "namespace/name@1.0.0" or a key).
# Each is checked first: its Model Passport (creator signature, malware checks, benchmark, verifier
# quorum), then every weights file against the passport's sha256, then the malware checks again.
# PROVIDER_MODELS=kinetic/ticket-classifier
# PROVIDER_MODEL_IMPORT=ollama        import checked safetensors weights into the local Ollama
# PROVIDER_SANDBOX=docker:no-network  how you isolate the model runtime, declared in your offer (see docker/)

# ── Buyer agent ───────────────────────────────────────────────────────────────
VERIFIER_URL=http://localhost:4500
AGENT_MAX_PRICE_TINYBAR=500000
AGENT_MAX_JOB_SPEND_TINYBAR=50000000
# Optional comma-separated provider EVM addresses.
AGENT_ALLOWLIST=
# How providers are ranked: cheapest | balanced | fastest (price, track record, measured speed).
AGENT_STRATEGY=balanced
# Work with at most this many providers at once; the next best wait as reserves. Empty = all.
AGENT_MAX_PROVIDERS=
# Skip providers whose estimated reliability (0..1) is below this, once they have 5+ checks. Empty = off.
AGENT_MIN_RELIABILITY=
# true: only work with providers whose 0G Compute provider can be TEE-attested (read from the 0G
# chain). Either way, attestable 0G providers are preferred.
AGENT_REQUIRE_ATTESTATION=
# true: also send chunk keys unwrapped to providers whose offer publishes no encryption key.
# Default off: chunk keys only travel wrapped to the provider's own public key.
AGENT_ALLOW_PLAIN_KEYS=
