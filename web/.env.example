# The dashboard asks the verifier where to read Arkiv and the mirror node from.
VITE_VERIFIER_URL=http://localhost:4500
# The buyer agent's local control API ("Run a job"), started by `--serve`.
VITE_AGENT_URL=http://localhost:4600
# 0G's Privy app id (0G shares it with hackathon teams; it only works on localhost 3000/3001/5173).
# With it, "Sign in with 0G" signs users into their 0G account; without it, users can paste a
# 0G management key (mk-…) instead.
VITE_PRIVY_APP_ID=
